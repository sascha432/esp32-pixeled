# Espressif ESP32-S3-DevKitC-1 N16R8: 16 MB flash, 8 MB octal PSRAM.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_PX_BOARD_ESP32S3_DEVKIT=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/16mb.csv"

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# mbedTLS allocates from PSRAM in the main firmware only (sdkconfig.main.esp32s3): in the recovery
# app it stays internal, so that app starts when the PSRAM fails
